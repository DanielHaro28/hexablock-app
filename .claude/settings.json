{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(flutter test *)",
      "Bash(flutter analyze *)",
      "Bash(flutter pub get)",
      "Bash(dart analyze *)",
      "Bash(dart format *)",
      "Bash(dart test *)",
      "Bash(dart pub get)",
      "Bash(python3 -I tools/docs-check/*)",
      "Bash(python3 -I tools/reference-sim/*)",
      "Bash(python -I tools/docs-check/*)",
      "Bash(python -I tools/reference-sim/*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git branch *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(flutter test *)",
      "PowerShell(flutter analyze *)",
      "PowerShell(flutter pub get)",
      "PowerShell(dart analyze *)",
      "PowerShell(dart format *)",
      "PowerShell(dart test *)",
      "PowerShell(dart pub get)",
      "PowerShell(python3 -I tools/docs-check/*)",
      "PowerShell(python3 -I tools/reference-sim/*)",
      "PowerShell(python -I tools/docs-check/*)",
      "PowerShell(python -I tools/reference-sim/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Edit(/.github/workflows/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Bash(flutter pub add *)",
      "Bash(dart pub add *)",
      "Bash(flutter pub upgrade *)",
      "Bash(dart pub upgrade *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(flutter pub add *)",
      "PowerShell(dart pub add *)",
      "PowerShell(flutter pub upgrade *)",
      "PowerShell(dart pub upgrade *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/key.properties)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(aws *)",
      "Bash(docker system prune *)",
      "PowerShell(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f*)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(aws *)",
      "PowerShell(docker system prune *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": [
    "dart"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ]
  }
}