# Based on the Flutter app template (flutter create), adapted to this
# repository: the Flutter app lives in app/ and the Dart packages in packages/.
# Lock files (pubspec.lock, package-lock.json) are committed on purpose: this
# is an application, so builds must be reproducible (R-03).

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
__pycache__/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder holds launch configurations and tasks; keep it out of
# version control unless the team agrees on shared settings.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/

# Coverage reports (generated in CI, D-58)
coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio places build artifacts here
app/android/app/debug
app/android/app/profile
app/android/app/release

# Node tooling for commit hooks (G-07)
node_modules/

# Secrets and local agent settings (SECURITY-BASELINE)
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pem
key.properties
.claude/settings.local.json
CLAUDE.local.md

# PlantUML export folder of the VS Code extension (D-76)
out/
