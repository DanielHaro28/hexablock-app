  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "level_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"level_results\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"game_id\" TEXT NOT NULL, \"topology\" TEXT NOT NULL, \"level_id\" TEXT NOT NULL, \"stars\" INTEGER NULL, \"time_ms\" INTEGER NULL, \"moves\" INTEGER NOT NULL, \"score\" INTEGER NULL, \"achieved_at\" INTEGER NOT NULL, \"pending\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending\" IN (0, 1)), \"revision\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"profile_id\", \"game_id\", \"topology\", \"level_id\"));"
        }
      ]
    },
    {
      "name": "records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"records\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"game_id\" TEXT NOT NULL, \"topology\" TEXT NOT NULL, \"score\" INTEGER NOT NULL, \"achieved_at\" INTEGER NOT NULL, \"pending\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending\" IN (0, 1)), \"revision\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"profile_id\", \"game_id\", \"topology\"));"
        }
      ]
    },
    {
      "name": "saved_games",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_games\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"game_id\" TEXT NOT NULL, \"topology\" TEXT NOT NULL, \"state_json\" TEXT NOT NULL, \"codec_version\" INTEGER NOT NULL, \"saved_at\" INTEGER NOT NULL, PRIMARY KEY (\"profile_id\", \"game_id\", \"topology\"));"
        }
      ]
    },
    {
      "name": "downloaded_levels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"downloaded_levels\" (\"id\" TEXT NOT NULL, \"game_id\" TEXT NOT NULL, \"topology\" TEXT NOT NULL, \"order\" INTEGER NOT NULL, \"version\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, \"downloaded_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
