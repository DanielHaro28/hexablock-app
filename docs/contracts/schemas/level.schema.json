{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexablock-api.example/contracts/schemas/level.schema.json",
  "title": "Level",
  "description": "A level of a level-based variant (RN-COM-70 to 77, D-47). One common part plus a 'variant' section whose content depends on gameId. The same schema validates the levels bundled in the app (CI) and the ones sent to POST/PUT /v1/levels. Structural and geometric rules that a schema cannot express (RN-HF-12, RN-HS-12) are checked by the level validators (D-19).",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/levelId" },
    "gameId": { "$ref": "common.schema.json#/$defs/levelGameId" },
    "topology": { "$ref": "common.schema.json#/$defs/levelTopology" },
    "order": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "common.schema.json#/$defs/localizedText" },
    "variant": { "type": "object" }
  },
  "required": ["id", "gameId", "topology", "order", "version", "name", "variant"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "gameId": { "const": "hexa-fit" } } },
      "then": {
        "properties": {
          "id": { "pattern": "^fit-" },
          "topology": { "not": { "const": "any" } },
          "variant": { "$ref": "#/$defs/fitVariant" }
        }
      }
    },
    {
      "if": { "properties": { "gameId": { "const": "hexa-sort" } } },
      "then": {
        "properties": {
          "id": { "pattern": "^sort-" },
          "variant": { "$ref": "#/$defs/sortVariant" }
        }
      }
    },
    {
      "if": {
        "properties": { "gameId": { "const": "hexa-sort" }, "topology": { "const": "any" } },
        "required": ["gameId", "topology"]
      },
      "then": {
        "properties": {
          "variant": {
            "properties": { "initialStacks": { "maxItems": 0 } },
            "not": { "required": ["board"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "pieceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,8}$" },
    "fitVariant": {
      "description": "Hexa Fit section (RN-HF-11): the figure to cover, the pieces, the star thresholds (RN-HF-62) and the reference solution (absolute cells per piece). The solution is never shown to the player (RN-HF-13).",
      "type": "object",
      "properties": {
        "figure": { "$ref": "common.schema.json#/$defs/cellList", "minItems": 1, "maxItems": 100 },
        "pieces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/pieceId" },
              "color": { "$ref": "common.schema.json#/$defs/color" },
              "shape": {
                "description": "Normalized cells in the initial orientation; 1 to 6 connected cells (RN-HF-12 b).",
                "$ref": "common.schema.json#/$defs/cellList",
                "minItems": 1,
                "maxItems": 6
              }
            },
            "required": ["id", "color", "shape"],
            "additionalProperties": false
          }
        },
        "starThresholds": {
          "description": "m and t of RN-HF-62. The validator checks m >= number of pieces (RN-HF-63).",
          "type": "object",
          "properties": {
            "moves": { "type": "integer", "minimum": 1 },
            "timeMs": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "required": ["moves", "timeMs"],
          "additionalProperties": false
        },
        "solution": {
          "description": "Piece id -> absolute cells it covers in the figure (RN-HF-11).",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/pieceId" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/cellList", "minItems": 1, "maxItems": 6 },
          "minProperties": 1
        }
      },
      "required": ["figure", "pieces", "starThresholds", "solution"],
      "additionalProperties": false
    },
    "sortVariant": {
      "description": "Hexa Sort section (RN-HS-11). Without 'board' the default board of the topology is used (RN-TOP-11).",
      "type": "object",
      "properties": {
        "goals": { "type": "integer", "minimum": 1, "maximum": 50 },
        "palette": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/color" },
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true
        },
        "seed": { "description": "xorshift32 seed (RN-COM-43).", "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "generation": {
          "description": "Stack generation parameters (RN-HS-21).",
          "type": "object",
          "properties": {
            "minHeight": { "type": "integer", "minimum": 2, "maximum": 6 },
            "maxHeight": { "type": "integer", "minimum": 2, "maximum": 6 },
            "maxBlocks": { "type": "integer", "minimum": 1, "maximum": 3 }
          },
          "required": ["minHeight", "maxHeight", "maxBlocks"],
          "additionalProperties": false
        },
        "board": {
          "description": "Optional custom board. Not allowed with topology 'any'.",
          "$ref": "common.schema.json#/$defs/cellList",
          "minItems": 2,
          "maxItems": 100
        },
        "initialStacks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "cell": { "$ref": "common.schema.json#/$defs/cell" },
              "stack": {
                "description": "Tiles from bottom to top (RN-HS-01). The validator checks that the top block has fewer than 10 tiles (RN-HS-12).",
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/color" },
                "minItems": 1,
                "maxItems": 20
              }
            },
            "required": ["cell", "stack"],
            "additionalProperties": false
          }
        }
      },
      "required": ["goals", "palette", "seed", "generation"],
      "additionalProperties": false
    }
  }
}
