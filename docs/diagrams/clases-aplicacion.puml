@startuml clases-aplicacion
' Diagrama de clases de DETALLE: casos de uso, puertos y aspectos AOP (capa 2),
' presentadores, gateways y códecs (capa 3), y repositorios sobre frameworks
' y composition root (capa 4, D-156).
' Parte de clases.puml (D-76). Las clases marcadas «motor» están completas en
' clases-motor.puml; aquí solo aparece su nombre para mostrar la conexión.
' Imagen: abrir este archivo → Ctrl+Shift+P → "PlantUML: Export Current Diagram" → png.
' Los nombres son los previstos en ARQ-03; se revisan contra el código real.

set namespaceSeparator none
hide circle
hide <<motor>> members
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam PackageBorderColor #999999
skinparam nodesep 30
skinparam ranksep 45

package "Capa 4 · Frameworks (app/lib/frameworks, config)" {
  interface VariantModule <<interface>> {
    + open<C extends Coord>(e: TopologyEntry<C>, o: StartOptions): Widget
  }
  class HexaLinesModule {
    + open<C extends Coord>(e: TopologyEntry<C>, o: StartOptions): Widget
  }
  class Injection <<Singleton via get_it>> {
    + registerAll(): void
  }
  class AudioFacade <<Facade>> {
    + onEvent(e: GameEvent): void
  }
  class DriftSavedGameRepository<TState> <<Adapter>> {
    - db: AppDatabase
    - codec: IGameStateCodec<TState>
    + scheduleSave(k: SavedGameKey, g: SavedGame<TState>): void
    + flush(): Future<void>
  }
  class DriftProgressRepository <<Adapter>> {
    - db: AppDatabase
    + load(p: ProfileId, k: GameKey): Future<VariantProgress?>
    + save(p: ProfileId, k: GameKey, v: VariantProgress): Future<void>
  }
  class DriftSyncOutbox <<Adapter>> {
    - db: AppDatabase
    + pending(p: ProfileId): Future<List<ResultKey>>
  }
  class SecureSessionStore <<Adapter>> {
    - storage: FlutterSecureStorage
    + read(): Future<Session?>
    + write(s: Session): Future<void>
  }
  class DriftUnitOfWork <<Adapter>> {
    - db: AppDatabase
    + run<T>(work: Future<T> Function()): Future<T>
  }
}

package "Capa 3 · Adaptadores (app/lib/adapters)" {
  class GameCubit<C extends Coord, TCell extends Object, TMove, TState extends GameState> <<Observer>> {
    - applyMove: ICommandService<TMove, MoveResult>
    - undo: ICommandService<(), TState>
    + onMove(m: TMove): void
    + onUndo(): void
  }
  class LinesStateCodec <<Adapter>> {
    + encode(s: LinesState): Map<String, Object?>
    + decode(json: Map<String, Object?>): LinesState
  }
  class HttpProgressGateway <<Adapter>> {
    - http: Dio
    + push(k: GameKey, v: VariantProgress): Future<VariantProgress>
  }
  class HttpAuthGateway <<Adapter>> {
    - http: Dio
    + login(c: Credentials): Future<AuthToken>
  }
}

package "Capa 2 · Casos de uso (hexa_application)" {
  interface ICommandService<TCommand, TResult> <<interface>> {
    + execute(command: TCommand): Future<Either<AppFailure, TResult>>
  }
  abstract class Either<L, R> <<sealed>>
  class Left<L, R> {
    + value: L
  }
  class Right<L, R> {
    + value: R
  }
  abstract class Aspect<TCommand, TResult> <<Decorator>> {
    + inner: ICommandService<TCommand, TResult>
  }
  class AspectChain {
    + wrap<TCommand, TResult>(s: ICommandService<TCommand, TResult>): ICommandService<TCommand, TResult>
  }
  class SessionAspect<TCommand, TResult> <<Proxy>> <<AOP>> {
    - session: ISessionStore
  }
  class ExceptionAspect<TCommand, TResult> <<Decorator>> <<AOP>>
  class MetricsAspect<TCommand, TResult> <<Decorator>> <<AOP>> {
    - metrics: IMetrics
  }
  class LoggingAspect<TCommand, TResult> <<Decorator>> <<AOP>> {
    - logger: ILogger
  }

  class StartGameUseCase<C extends Coord, TCell extends Object, TMove, TState extends GameState> {
    + execute(o: StartOptions): Future<GameSession>
  }
  class ApplyMoveUseCase<C extends Coord, TCell extends Object, TMove, TState extends GameState> {
    + execute(m: TMove): Future<MoveResult>
  }
  class UndoMoveUseCase<C extends Coord, TCell extends Object, TMove, TState extends GameState> {
    + execute(): Future<TState>
  }
  class SaveProgressUseCase {
    + execute(r: GameResult): Future<VariantProgress>
  }
  class SyncProgressUseCase {
    + execute(): Future<SyncReport>
  }
  class LoginUseCase {
    + execute(c: Credentials): Future<Profile>
  }

  interface ISavedGameRepository<TState> <<interface>> {
    + scheduleSave(k: SavedGameKey, g: SavedGame<TState>): void
    + flush(): Future<void>
    + load(k: SavedGameKey): Future<SavedGame<TState>?>
    + delete(k: SavedGameKey): void
    + exists(p: ProfileId): Future<bool>
  }
  interface IGameStateCodec<TState> <<interface>> {
    + encode(s: TState): Map<String, Object?>
    + decode(json: Map<String, Object?>): TState
  }
  interface IProgressRepository <<interface>> {
    + load(p: ProfileId, k: GameKey): Future<VariantProgress?>
    + save(p: ProfileId, k: GameKey, v: VariantProgress): Future<void>
  }
  interface IUnitOfWork <<interface>> {
    + run<T>(work: Future<T> Function()): Future<T>
  }
  interface ISyncOutbox <<interface>> {
    + markPending(p: ProfileId, k: GameKey, r: ResultKey): Future<void>
    + pending(p: ProfileId): Future<List<ResultKey>>
  }
  interface IProgressGateway <<interface>> {
    + push(k: GameKey, v: VariantProgress): Future<VariantProgress>
  }
  interface IAuthGateway <<interface>> {
    + login(c: Credentials): Future<AuthToken>
  }
  interface ISessionStore <<interface>> {
    + read(): Future<Session?>
    + write(s: Session): Future<void>
  }
  interface ILogger <<interface>> {
    + log(e: LogEntry): void
  }
  interface IMetrics <<interface>> {
    + record(name: String, elapsed: Duration): void
  }
}

package "Capa 1 · hexa_engine (detalle en clases-motor)" {
  interface VariantFamily<C extends Coord, TCell extends Object, TMove, TState extends GameState> <<motor>>
  class GameSession<C extends Coord, TCell extends Object, TMove, TState extends GameState> <<motor>>
  abstract class GameEvent<C extends Coord> <<motor>>
}

' ===== Capa 4 =====
HexaLinesModule ..|> VariantModule
Injection ..> VariantModule : registra
HexaLinesModule ..> GameCubit : crea
HexaLinesModule ..> AspectChain : usa
HexaLinesModule ..> StartGameUseCase : crea
AudioFacade ..> GameEvent : escucha

' ===== Capa 3 → capa 2 =====
GameCubit --> ICommandService : casos de uso envueltos
DriftSavedGameRepository ..|> ISavedGameRepository
DriftSavedGameRepository --> IGameStateCodec
LinesStateCodec ..|> IGameStateCodec : «bind» TState = LinesState
DriftProgressRepository ..|> IProgressRepository
DriftSyncOutbox ..|> ISyncOutbox
DriftUnitOfWork ..|> IUnitOfWork
HttpProgressGateway ..|> IProgressGateway
HttpAuthGateway ..|> IAuthGateway
SecureSessionStore ..|> ISessionStore

' ===== Aspectos (AOP con decoradores, D-40, D-41 y D-160) =====
Left --|> Either
Right --|> Either
ICommandService ..> Either : devuelve
Aspect ..|> ICommandService
Aspect o-- ICommandService : envuelve
SessionAspect --|> Aspect
ExceptionAspect --|> Aspect
MetricsAspect --|> Aspect
LoggingAspect --|> Aspect
AspectChain ..> SessionAspect : arma
AspectChain ..> ExceptionAspect : arma
AspectChain ..> MetricsAspect : arma
AspectChain ..> LoggingAspect : arma
SessionAspect --> ISessionStore
MetricsAspect --> IMetrics
LoggingAspect --> ILogger

' ===== Casos de uso → puertos =====
StartGameUseCase ..|> ICommandService
ApplyMoveUseCase ..|> ICommandService
UndoMoveUseCase ..|> ICommandService
SaveProgressUseCase ..|> ICommandService
SyncProgressUseCase ..|> ICommandService
LoginUseCase ..|> ICommandService
StartGameUseCase --> ISavedGameRepository
ApplyMoveUseCase --> ISavedGameRepository
UndoMoveUseCase --> ISavedGameRepository
SaveProgressUseCase --> IProgressRepository
SaveProgressUseCase --> ISyncOutbox
SaveProgressUseCase --> IUnitOfWork : lee, consolida y escribe (D-158)
SyncProgressUseCase --> IProgressGateway
SyncProgressUseCase --> IProgressRepository
SyncProgressUseCase --> ISyncOutbox
LoginUseCase --> IAuthGateway
LoginUseCase --> ISessionStore

' ===== Capa 2 → capa 1 =====
StartGameUseCase --> VariantFamily : crea la sesión
ApplyMoveUseCase --> GameSession : usa
UndoMoveUseCase --> GameSession : usa

legend right
  **Cómo leerlo**
  «motor» = clase de hexa_engine, completa en clases-motor.puml
  ..|> implementa una interfaz · --> usa · ..> crea o usa de paso
  o-- agregación (el aspecto envuelve otro caso de uso)
  «bind» = instancia un parámetro genérico · «...» = patrón de diseño (ARQ-03 §7)
  Orden de los aspectos: sesión → errores → métricas → registro (D-41)
  Los otros casos de uso (niveles, ranking, registro, invitado, ajustes) siguen
  el mismo camino: ICommandService → puerto de la capa 2 → adaptador de la capa 3 (ARQ-03 §3, §4)
  Fit, Sort y Merge tienen su módulo y su codec como Hexa Lines
endlegend

@enduml
