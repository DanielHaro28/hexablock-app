@startuml clases
' Diagrama de clases GENERAL de hexablock-app (enunciado §4.1, D-43, D-76).
' Muestra las 4 capas y cómo se comunican: cada capa externa usa una interfaz
' (puerto) de la capa de adentro, y las flechas apuntan siempre hacia el dominio.
' El detalle de cada parte está en:
'   clases-motor.puml       motor genérico (capa 1)
'   clases-variantes.puml   cómo cada variante instancia el motor (capa 1)
'   clases-aplicacion.puml  casos de uso, puertos, aspectos y adaptadores (capas 2 a 4)
' Imagen: abrir este archivo → Ctrl+Shift+P → "PlantUML: Export Current Diagram" → png.
' Los nombres son los previstos en ARQ-02 y ARQ-03; se revisan contra el código real.

set namespaceSeparator none
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam PackageBorderColor #999999
skinparam nodesep 35
skinparam ranksep 45

package "Capa 4 · Frameworks (app/lib/frameworks, config)" {
  class HexaLinesModule {
    + open<C extends Coord>(e: TopologyEntry<C>, o: StartOptions): Widget
  }
  class Injection <<Singleton via get_it>> {
    + registerAll(): void
  }
  class DriftSavedGameRepository<TState> <<Adapter>> {
    - db: AppDatabase
    + scheduleSave(k: SavedGameKey, g: SavedGame<TState>): void
  }
  class DriftProgressRepository <<Adapter>> {
    - db: AppDatabase
    + save(p: ProfileId, k: GameKey, v: VariantProgress): Future<void>
  }
}

package "Capa 3 · Adaptadores (app/lib/adapters)" {
  class GameCubit<C extends Coord, TCell extends Object, TMove, TState extends GameState> <<Observer>> {
    - applyMove: ICommandService<TMove, MoveResult>
    + onMove(m: TMove): void
  }
  class HttpProgressGateway <<Adapter>> {
    - http: Dio
    + push(k: GameKey, v: VariantProgress): Future<VariantProgress>
  }
}

package "Capa 2 · Casos de uso (hexa_application)" {
  interface ICommandService<TCommand, TResult> <<interface>> {
    + execute(command: TCommand): Future<Either<AppFailure, TResult>>
  }
  class LoggingAspect<TCommand, TResult> <<Decorator>> <<AOP>> {
    - inner: ICommandService<TCommand, TResult>
    - logger: ILogger
    + execute(command: TCommand): Future<Either<AppFailure, TResult>>
  }
  class ApplyMoveUseCase<C extends Coord, TCell extends Object, TMove, TState extends GameState> {
    - session: GameSession
    - savedGames: ISavedGameRepository<TState>
    + execute(m: TMove): Future<MoveResult>
  }
  class SaveProgressUseCase {
    - progress: IProgressRepository
    + execute(r: GameResult): Future<VariantProgress>
  }
  class SyncProgressUseCase {
    - gateway: IProgressGateway
    - progress: IProgressRepository
    + execute(): Future<SyncReport>
  }
  interface ISavedGameRepository<TState> <<interface>> {
    + scheduleSave(k: SavedGameKey, g: SavedGame<TState>): void
    + flush(): Future<void>
  }
  interface IProgressRepository <<interface>> {
    + load(p: ProfileId, k: GameKey): Future<VariantProgress?>
    + save(p: ProfileId, k: GameKey, v: VariantProgress): Future<void>
  }
  interface IProgressGateway <<interface>> {
    + push(k: GameKey, v: VariantProgress): Future<VariantProgress>
  }
}

package "Capa 1 · Entidades (hexa_engine, hexa_topologies, hexa_variants)" {
  interface VariantFamily<C extends Coord, TCell extends Object, TMove, TState extends GameState> <<interface>> <<Abstract Factory>> {
    + createRules(): IGameRules
    + createSession(o: NewGameOptions): GameSession
    + continueSession(saved: SavedGame): GameSession
  }
  class GameSession<C extends Coord, TCell extends Object, TMove, TState extends GameState> {
    + engine: GameEngine
    + undo: IUndoable?
  }
  class GameEngine<C extends Coord, TCell extends Object, TMove, TState extends GameState> <<Observer>> {
    + state: TState
    + phase: GamePhase
    + submit(m: TMove): MoveResult
  }
  interface IGameRules<C extends Coord, TCell extends Object, TMove, TState extends GameState> <<interface>> <<Strategy>> {
    + validMoves(s: TState): Iterable<TMove>
    + playTurn(s: TState, m: TMove): TurnResult
  }
  abstract class GameRules<C extends Coord, TCell extends Object, TMove, TState extends GameState> <<Template Method>> {
    + playTurn(s: TState, m: TMove): TurnResult
    # rejectionOf(s: TState, m: TMove): RejectionReason?
    # apply(s: TState, m: TMove): Step
    # resolve(s: TState): Step
    # evaluate(s: TState): GameOutcome
  }
  abstract class GamePhase <<State>> {
    + acceptsMoves: bool
    + allowsUndo: bool
  }
  class Board<C extends Coord, TCell extends Object> <<Bridge>> {
    + cell(c: C): TCell?
    + withCells(changes: Map<C, TCell?>): Board
  }
  abstract class GridTopology<C extends Coord> {
    + neighbors(c: C): List<C>
    + lines(cells: Set<C>, axis: Axis): Iterable<List<C>>
  }
  class HexTopology
  class HexaLinesRules<C extends Coord>
  class HexaFitRules<C extends Coord>
  class HexaSortRules<C extends Coord>
  class HexaMergeRules<C extends Coord>
  class HexaLinesFactory<C extends Coord>
}

' ===== Capa 4 → capas internas =====
Injection ..> HexaLinesModule : registra
HexaLinesModule ..> GameCubit : crea
HexaLinesModule ..> HexaLinesFactory : crea
HexaLinesModule ..> LoggingAspect : envuelve los casos de uso

' ===== Capa 3 → capa 2 =====
GameCubit --> ICommandService : usa
DriftSavedGameRepository ..|> ISavedGameRepository
DriftProgressRepository ..|> IProgressRepository
HttpProgressGateway ..|> IProgressGateway

' ===== Capa 2 =====
LoggingAspect ..|> ICommandService
LoggingAspect o-- ICommandService : envuelve
ApplyMoveUseCase ..|> ICommandService
SaveProgressUseCase ..|> ICommandService
SyncProgressUseCase ..|> ICommandService
ApplyMoveUseCase --> ISavedGameRepository
SaveProgressUseCase --> IProgressRepository
SyncProgressUseCase --> IProgressGateway
SyncProgressUseCase --> IProgressRepository

' ===== Capa 2 → capa 1 =====
ApplyMoveUseCase --> GameSession : usa

' ===== Capa 1 =====
HexaLinesFactory ..|> VariantFamily : «bind» TCell = PieceColor, TMove = PlacePiece, TState = LinesState
VariantFamily ..> GameSession : crea
GameSession *-- GameEngine
GameEngine --> IGameRules : usa (Strategy)
GameEngine *-- GamePhase : fase actual
GameRules ..|> IGameRules
HexaLinesRules --|> GameRules : «bind» PieceColor, PlacePiece, LinesState
HexaFitRules --|> GameRules : «bind» PieceId, FitMove, FitState
HexaSortRules --|> GameRules : «bind» ColorStack, PlaceStack, SortState
HexaMergeRules --|> GameRules : «bind» Tile, Slide, MergeState
GameRules ..> Board : lee y produce
Board --> GridTopology : delega la geometría
HexTopology --|> GridTopology : «bind» C = HexCoord

legend right
  **Cómo leerlo**
  ..|> implementa una interfaz
  --|> hereda de una clase
  --> usa (dependencia que se guarda)
  ..> crea o usa de paso
  *-- composición · o-- agregación
  «bind» = cómo una variante o figura instancia los parámetros genéricos
  «...» en una clase = patrón de diseño (ARQ-02 §9, ARQ-03 §7)
  Todas las flechas entre capas apuntan hacia la capa 1
endlegend

@enduml
